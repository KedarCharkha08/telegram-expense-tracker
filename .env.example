# ---- Telegram ----
# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random string you invent (32+ chars). Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so the webhook can reject impostors.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user IDs allowed to log expenses.
# Leave blank on first run, message the bot, and read the id from the logs.
ALLOWED_USER_IDS=

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key. BACKEND ONLY. Never put this in the Streamlit app.
SUPABASE_SERVICE_KEY=

# anon key. Used by the dashboard (read-only via RLS policy).
SUPABASE_ANON_KEY=

# Password gate for the public Streamlit URL.

# ---- Misc ----
TIMEZONE=Asia/Kolkata
CURRENCY=INR
