# Copy to .streamlit/secrets.toml for local runs (gitignored).
# On Streamlit Community Cloud paste these into App → Settings → Secrets.
#
# Note this uses the PUBLISHABLE key, not the secret one. The dashboard only
# ever reads, and RLS enforces that. Never put sb_secret_... here.

SUPABASE_URL = "https://eereuiayalwjeantusel.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_..."
DASHBOARD_PASSWORD = "pick-something-long"
TIMEZONE = "Asia/Kolkata"
